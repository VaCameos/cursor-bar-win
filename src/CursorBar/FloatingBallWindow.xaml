<Window x:Class="CursorBar.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cursor Bar"
        Width="68"
        Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Ellipse Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <SolidColorBrush Color="#E6282C34"/>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="#FF000000"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#40FFFFFF" StrokeThickness="1"/>
        <StackPanel VerticalAlignment="Center" Margin="14,0">
            <Grid Height="9">
                <Border x:Name="TopTrack" CornerRadius="4.5" Background="#33FFFFFF"/>
                <Border x:Name="TopFill" HorizontalAlignment="Left" CornerRadius="4.5" Width="0"/>
            </Grid>
            <Grid Height="4" Margin="0,5,0,0">
                <Border x:Name="BottomTrack" CornerRadius="2" Background="#22FFFFFF"/>
                <Border x:Name="BottomFill" HorizontalAlignment="Left" CornerRadius="2" Width="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
